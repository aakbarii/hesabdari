{
  "name": "hesabdari",
  "version": "0.1.0",
  "private": true,
  "description": "Ravaal - Personal Life & Finance Management",
  "author": "Saman",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/reliability.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "share": "powershell -ExecutionPolicy Bypass -File scripts/share.ps1",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:node": "node scripts/ensure-portable-node.mjs",
    "desktop:fix": "node scripts/fix-desktop-pack.mjs",
    "desktop": "npm run build && npm run desktop:prepare && electron .",
    "desktop:build": "npm run build && npm run desktop:prepare && npm run desktop:node && node scripts/package-desktop.mjs dir && npm run desktop:fix && node scripts/package-desktop.mjs installers"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "jalali-moment": "^3.3.11",
    "lucide-react": "^1.23.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.9",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
