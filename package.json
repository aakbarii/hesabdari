{
  "name": "hesabdari",
  "version": "0.1.0",
  "private": true,
  "description": "Personal finance and life manager",
  "author": "Hesabdari",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "share": "powershell -ExecutionPolicy Bypass -File scripts/share.ps1",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:node": "node scripts/ensure-portable-node.mjs",
    "desktop:fix": "node scripts/fix-desktop-pack.mjs",
    "desktop": "npm run build && npm run desktop:prepare && electron .",
    "desktop:build": "npm run build && npm run desktop:prepare && npm run desktop:node && electron-builder --win dir --config.npmRebuild=false && npm run desktop:fix && electron-builder --win nsis portable --prepackaged dist-desktop/win-unpacked --config.npmRebuild=false"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "jalali-moment": "^3.3.11",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "otpauth": "^9.5.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
